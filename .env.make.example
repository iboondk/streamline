# Copy to .env.make (git-ignored) and uncomment the lines you need.
# The Makefile includes .env.make if it exists. Without it, the tools use their standard caches.
# Example for a machine with a separate cache drive:
# GOMODCACHE=/path/to/caches/go
# npm_config_cache=/path/to/caches/npm
# PIP_CACHE_DIR=/path/to/caches/pip
